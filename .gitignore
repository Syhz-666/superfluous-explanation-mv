# ── 依赖 ──
node_modules/

# ── 渲染产物 ──
# 成片有 157MB，不适合进版本库。想要看请自己渲染，见 README。
out/

# ── 分析中间产物 ──
# 含 demucs 分离出的人声轨（约 200MB）和 whisper 模型缓存（约 1.6GB），
# 都能用 scripts/ 下的脚本重新生成。
analysis/

# ── 不进仓库的原始素材 ──
# 歌曲是有版权的商业录音，进仓库等于再分发。请自行准备音频，
# 放到 assets/ 下（文件名见 README）。47MB 也算大的。
assets/*.wav
# 酷我音乐的 DRM 加密格式，任何工具都解不开，留着只会让仓库变大。
assets/*.kwm

# ── 别的工具留在本目录的东西，不属于这个项目 ──
.workbuddy/

# ── 系统 ──
.DS_Store
Thumbs.db
desktop.ini
